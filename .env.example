# Canonical origin used for canonical URLs, sitemap, llms.txt and JSON-LD.
SITE_URL=https://www.genesyx.life

# Crawlers are allowed by default. Set to false (e.g. on a staging project) to make every page
# noindex and have robots.txt disallow all crawlers.
PUBLIC_INDEXABLE=true

# Supabase project (publishable/anon key only; RLS restricts it to inserting into public.waitlist).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
