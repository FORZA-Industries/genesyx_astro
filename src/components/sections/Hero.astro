---
import { Picture } from "astro:assets";
import PathChoice from "@/components/PathChoice.astro";
import hero from "@/assets/images/hero-app-formulas.jpg";
---

<section class="wrap grid items-center gap-10 pt-10 pb-16 lg:grid-cols-[1fr_1.1fr] lg:pt-16 lg:pb-24">
  <div class="max-w-xl">
    <p class="eyebrow flex items-center gap-3">
      <span
        class="h-0.5 w-6 rounded-full bg-linear-to-r from-lavender via-pink to-aqua"
        aria-hidden="true"
      ></span>
      The XX / XY preconception programme
    </p>
    <h1 class="display mt-6">Try with intention.</h1>
    <p class="mt-6 max-w-sm text-lg leading-snug text-body">
      A considered 90-day programme inspired by the Shettles theory.
    </p>

    <p class="eyebrow mt-9 text-[0.625rem] text-ink" id="hoping-label">
      I'm hoping for
    </p>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row" role="group" aria-labelledby="hoping-label">
      <PathChoice path="xx" />
      <PathChoice path="xy" />
    </div>
    <p class="mt-5 text-xs text-muted">
      Supplements · nutrition · vaginal pH tests · cycle timing · companion app
    </p>
  </div>

  <div class="mx-auto w-full max-w-xl">
    <Picture
      src={hero}
      alt="The Genesyx companion app showing cycle phase and vaginal pH trackers, between the Genesyx XX Formula and XY Formula boxes"
      formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1536]}
      sizes="(min-width: 1024px) 576px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full"
    />
  </div>
</section>
