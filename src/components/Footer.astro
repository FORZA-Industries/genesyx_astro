---
import Logo from "./Logo.astro";
import { site, learnLinks, companyLinks } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.2fr_1fr_1fr]">
    <div class="space-y-4">
      <Logo class="h-7 w-auto" />
      <p class="font-display text-lg text-ink">{site.tagline}</p>
      <p class="max-w-sm text-xs leading-relaxed text-muted">{site.disclaimer}</p>
    </div>
    <nav aria-label="Learn">
      <h2 class="eyebrow mb-4">Learn</h2>
      <ul class="space-y-2 text-sm text-ink">
        {learnLinks.map((l) => (
          <li>
            <a href={l.href} class="hover:text-lavender">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Company">
      <h2 class="eyebrow mb-4">Company</h2>
      <ul class="space-y-2 text-sm text-ink">
        <li>
          <a href="/#why" class="hover:text-lavender">
            Why Genesyx
          </a>
        </li>
        <li>
          <a href="/#inside" class="hover:text-lavender">
            The programme
          </a>
        </li>
        <li>
          <a href={site.links.appStore} rel="noopener" class="hover:text-lavender">
            Genesyx for iPhone
          </a>
        </li>
        <li>
          <a href={site.links.shop} rel="noopener" class="hover:text-lavender">
            Genesyx shop
          </a>
        </li>
        {companyLinks.map((l) => (
          <li>
            <a href={l.href} class="hover:text-lavender">
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/privacy" class="hover:text-lavender">
            Privacy
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="wrap border-t border-line py-6 text-xs text-muted">
    © {year} {site.name}, operated by {site.legalName}. All rights reserved. Genesyx is not a
    medical device or fertility treatment.
  </div>
</footer>
