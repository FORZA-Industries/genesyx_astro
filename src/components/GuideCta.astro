---
import { paths, type Path } from "@/data/site";
import { campaignFor, shopUrl } from "@/lib/shop";
import { cleanPath } from "@/lib/url";
interface Props {
  path?: Path;
}
const { path } = Astro.props;
const options = path ? [path] : (Object.keys(paths) as Path[]);
const campaign = campaignFor(cleanPath(Astro.url.pathname));
---

<aside class="mt-16 bg-white px-6 py-10 sm:px-10" aria-labelledby="guide-cta">
  <p class="eyebrow">Try with intention</p>
  <h2 id="guide-cta" class="mt-3 font-display text-3xl font-medium">
    {path ? `Join the ${paths[path].label} first release` : "Which path are you hoping for?"}
  </h2>
  <div class="mt-6 flex flex-col gap-3">
    {options.map((p) => (
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={`/?path=${p}#join`} class="btn-primary">
          Join the {paths[p].label} list <span aria-hidden="true">→</span>
        </a>
        <a href={shopUrl(paths[p].productUrl, campaign, "guide-cta")} class="btn-secondary">
          Shop {paths[p].product} <span aria-hidden="true">↗</span>
        </a>
      </div>
    ))}
  </div>
  <p class="mt-4 text-sm text-muted">
    {path
      ? `${paths[path].product} is available now from the Genesyx shop.`
      : "XX and XY Formula are available now from the Genesyx shop."}
  </p>
</aside>
