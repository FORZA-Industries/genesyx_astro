---
import type { CollectionEntry } from "astro:content";
interface Props {
  items: CollectionEntry<"faq">[];
  /** h3 under a section h2 (landing page); h2 directly under the page h1 (/faq). */
  headingLevel?: "h2" | "h3";
}
const { items, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<div class="border-t border-line">
  {items.map((item, i) => (
    <details class="group border-b border-line" id={item.id}>
      <summary class="flex cursor-pointer list-none items-center gap-6 py-6 text-ink [&::-webkit-details-marker]:hidden">
        <span class="w-5 text-[0.625rem] text-muted">{String(i + 1).padStart(2, "0")}</span>
        <Heading class="flex-1 font-display text-base font-medium tracking-normal">
          {item.data.question}
        </Heading>
        <span aria-hidden="true" class="text-lg transition group-open:rotate-45">
          +
        </span>
      </summary>
      <div class="pb-6 pl-11 text-sm leading-relaxed">
        <p>{item.data.answer}</p>
        {item.data.related && (
          <a
            href={item.data.related}
            class="mt-3 inline-block font-medium text-ink underline decoration-pink decoration-2 underline-offset-4"
          >
            Read more
          </a>
        )}
      </div>
    </details>
  ))}
</div>
