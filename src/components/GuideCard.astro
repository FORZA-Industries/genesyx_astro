---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";

interface Props {
  guide: CollectionEntry<"guides">;
  /** Heading level inside the card, so it nests correctly under the section heading. */
  as?: "h2" | "h3";
}

const { guide, as: Heading = "h3" } = Astro.props;
const { title, description, eyebrow, image, imageAlt, path } = guide.data;
---

<a
  href={`/${guide.id}`}
  class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-white transition hover:-translate-y-0.5 hover:shadow-md"
>
  {image ? (
    <Picture
      src={image}
      alt={imageAlt ?? ""}
      formats={["avif", "webp"]}
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
      class="aspect-[16/9] w-full object-cover"
    />
  ) : (
    <div
      aria-hidden="true"
      class="grid aspect-[16/9] w-full place-items-center bg-linear-to-br from-pink/40 via-lavender-soft/30 to-aqua/40 font-display text-5xl font-medium text-ink"
    >
      {path?.toUpperCase() ?? "G"}
    </div>
  )}
  <div class="flex flex-1 flex-col p-6">
    <p class="eyebrow text-[0.625rem]">{eyebrow}</p>
    <Heading class="mt-3 font-display text-lg font-medium text-ink group-hover:text-lavender">
      {title}
    </Heading>
    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{description}</p>
    <span class="mt-auto pt-5 text-sm font-medium text-ink">
      Read more <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
