---
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import GuideCta from "@/components/GuideCta.astro";
import { site, learnLinks, type Path } from "@/data/site";
import { article, breadcrumbs, webPage } from "@/lib/schema";
import { cleanPath } from "@/lib/url";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  summary: string;
  updated: Date;
  published?: Date;
  path?: Path;
  type?: "article" | "page";
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description,
  eyebrow,
  summary,
  updated,
  published,
  path,
  type = "article",
  noindex = false,
  schema = [],
  image,
  imageAlt = "",
} = Astro.props;
const base = Astro.site ?? Astro.url;
const pathname = cleanPath(Astro.url.pathname);
const related = learnLinks.filter((l) => l.href !== pathname);
// 1200x630 crop for social cards; its absolute URL also feeds the Article/WebPage schema.
const og = image
  ? await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg" })
  : undefined;
const ogImage = og && { src: og.src, width: 1200, height: 630 };
const imageUrl = og && new URL(og.src, base).toString();
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
// Only show "First published" when it differs from the last update.
const showPublished = published && published.toDateString() !== updated.toDateString();
const updatedLabel = updated.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title={title}
  description={description}
  ogType={type === "article" ? "article" : "website"}
  noindex={noindex}
  ogImage={ogImage}
  schema={[
    type === "article"
      ? article({ title, description, updated, published, path: pathname, image: imageUrl }, base)
      : webPage({ title, description, updated, path: pathname, image: imageUrl }, base),
    breadcrumbs(
      [
        { name: site.name, path: "/" },
        { name: title, path: pathname },
      ],
      base,
    ),
    ...schema,
  ]}
>
  <article class="wrap max-w-3xl py-14 lg:py-20">
    <nav aria-label="Breadcrumb" class="flex flex-wrap gap-1.5 text-xs text-muted">
      <a href="/" class="hover:text-ink">
        Home
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <p class="eyebrow mt-10">{eyebrow}</p>
    <h1 class="display-md mt-4">{title}</h1>
    <p class="mt-4 text-xs text-muted">
      {showPublished && (
        <>
          First published <time datetime={published.toISOString()}>{fmt(published)}</time>
          <span aria-hidden="true"> · </span>
        </>
      )}
      Last updated <time datetime={updated.toISOString()}>{updatedLabel}</time>
    </p>

    <!-- Answer-first summary: the passage search and AI engines are most likely to quote. -->
    <p class="mt-8 border-l-2 border-pink pl-5 text-lg leading-relaxed text-ink">{summary}</p>

    {image && (
      <Picture
        src={image}
        alt={imageAlt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 768px) 720px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mt-10 aspect-[16/9] w-full rounded-card object-cover"
      />
    )}

    <div class="prose-gx mt-10">
      <slot />
    </div>

    <p class="mt-12 text-xs leading-relaxed text-muted">
      {site.disclaimer} This page is general information, not medical advice.
    </p>

    <GuideCta path={path} />

    <nav aria-labelledby="related" class="mt-16">
      <h2 id="related" class="eyebrow">
        Keep reading
      </h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {related.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex items-center justify-between border-b border-line py-3 text-sm text-ink hover:text-lavender"
            >
              {l.label} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</BaseLayout>
