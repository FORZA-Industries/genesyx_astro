---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Why from "@/components/sections/Why.astro";
import Inside from "@/components/sections/Inside.astro";
import AppView from "@/components/sections/AppView.astro";
import Together from "@/components/sections/Together.astro";
import Questions from "@/components/sections/Questions.astro";
import Join from "@/components/sections/Join.astro";
import { site } from "@/data/site";
import { faqPage, mobileApplication } from "@/lib/schema";
import { faqForSchema } from "@/lib/text";

const featured = faqForSchema(
  (await getCollection("faq", (e) => e.data.featured)).sort((a, b) => a.data.order - b.data.order),
);
---

<BaseLayout
  title={site.name}
  description={site.description}
  schema={[faqPage(featured), mobileApplication(Astro.site ?? Astro.url)]}
>
  <Hero />
  <Why />
  <Inside />
  <AppView />
  <Together />
  <Questions />
  <Join />
</BaseLayout>
